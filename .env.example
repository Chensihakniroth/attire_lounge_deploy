# API Keys for External Integration (Khron / WooCommerce)
# Product/Stock API key — used for GET /api/v1/products/* and /api/v1/stock/*
API_KEY=your-product-api-key-here
# Webhook API key — used for POST /api/v1/orders/webhook
WEBHOOK_API_KEY=your-webhook-api-key-here

# Nile Cambodia Telegram Bot
# Set these in Railway for production; local dev falls back to .env values
NILE_TELEGRAM_BOT_TOKEN=
NILE_TELEGRAM_CHAT_ID=
# Comma-separated trusted reverse-proxy IPs/CIDRs (e.g. Railway LB / nginx).
# Keep "*" if unsure — used for X-Forwarded-For / scheme handling.
TRUSTED_PROXIES=*
